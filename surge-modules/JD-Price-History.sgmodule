[Script]
京东历史比价 = type=http-response, pattern=^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html(?:\?.*)?$, requires-body=true, max-size=-1, timeout=60, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker2/main/permanent-assets/r2-2026-09-03/scripts/jd_price.surge.js, script-update-interval=86400

慢慢买CK增强抓取 = type=http-request, pattern=^https?:\/\/(?:[^\/]+\.)?manmanbuy\.com\/, requires-body=true, max-size=-1, timeout=20, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker2/main/permanent-assets/r2-2026-09-03/scripts/jd_price.surge.js, script-update-interval=86400

[MITM]
hostname = %APPEND% in.m.jd.com, *.manmanbuy.com
