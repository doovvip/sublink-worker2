[Script]
MyCamera = type=http-response,pattern=^https?:\/\/api\.account\.meitu\.com\/.*$,script-path=https://raw.githubusercontent.com/doovvip/sublink-worker2/main/surge-scripts/mycamera.debug.js,requires-body=true,max-size=0,script-update-interval=86400

[MITM]
hostname = %APPEND% api.account.meitu.com
